# AyurAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

PORT=3000

# Firebase Admin SDK — database URL from Firebase console
FIREBASE_DATABASE_URL=https://ayurai-39fff-default-rtdb.asia-southeast1.firebasedatabase.app

# Gemini API Key — from https://aistudio.google.com/app/apikey
# Keep this server-side ONLY. Never put it in ESP32 firmware or Flutter app.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
