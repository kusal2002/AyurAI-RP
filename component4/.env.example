# Copy to component4/.env (git-ignored) and fill in. Never commit real secrets.
# This one file is read by both the Component 4 API and docker-compose.yml.

# ---------- Component 4 API ----------
# PostgreSQL connection. Leave empty to use the local SQLite fallback file.
# For the Docker database, use the same user/password/db as the Docker section below:
#   DATABASE_URL=postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/ayurai_audit
DATABASE_URL=

# JWT signing secret: at least 32 random bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Demo sign-in accounts (api/seed_users.py): practitioner.clinic1..3, supervisor,
# researcher. When set (8+ characters), the Docker container creates any missing
# accounts with this password on every start; existing accounts are not changed.
# Leave empty to skip. Change passwords later with:
#   python seed_users.py --password <new> --reset-passwords
C4_SEED_PASSWORD=

# Shared key that Component 2 / 3 send in the X-Service-Key header
# when posting audit events. Generate the same way as JWT_SECRET.
C4_SERVICE_API_KEY=

# ---------- Component 2's knowledge graph (FAKL, read-only) ----------
# Same AuraDB instance as component2/.env. Component 4 only ever reads from it.
C2_NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
C2_NEO4J_USERNAME=<username>
C2_NEO4J_PASSWORD=<password>
# Leave empty to use the server's default database
C2_NEO4J_DATABASE=

# ---------- Real training data (Component 1's datasets) ----------
# Folder OUTSIDE the repo (and outside OneDrive) holding the unzipped datasets,
# e.g. C:\ayurai-data\datasets. Never put patient images inside the repo.
C4_DATA_DIR=

# ---------- Blockchain anchoring (Ethereum Sepolia testnet) ----------
# Optional: without these the API runs normally and anchoring is reported as unavailable.
# Use a TEST-ONLY wallet holding nothing but free Sepolia ETH.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-key>
WALLET_ADDRESS=0x<your-test-wallet-address>
# Address of your deployed AuditAnchor contract (security/AuditAnchor.sol)
CONTRACT_ADDRESS=0x<deployed-contract-address>
# Signs anchor transactions. NEVER share, commit or screenshot this value.
WALLET_PRIVATE_KEY=<private-key-of-the-test-wallet>

# ---------- Docker (docker-compose.yml) ----------
# Privacy budget for `docker compose up` (federated nodes)
EPSILON=2.0

# PostgreSQL container (profile "db"). Choose your own password.
POSTGRES_USER=ayurai
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ayurai_audit

# Neo4j container (profile "db"). Username is always "neo4j"; the password
# must be at least 8 characters. Compose builds NEO4J_AUTH=neo4j/<password>.
NEO4J_PASSWORD=CHANGE_ME_8plus
