# Component 3 configuration template. Copy to component3/.env and fill in.
# .env is git-ignored; never commit credentials.

# Neo4j AuraDB (use the encrypted neo4j+s:// scheme for any non-local server).
# Note: Component 3 uses NEO4J_USER (Component 2 uses NEO4J_USERNAME).
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<username>
NEO4J_PASSWORD=<password>

# Optional (defaults shown)
# PORT=8003
# HIGH_RISK_THRESHOLD=0.70
# CAUTION_THRESHOLD=0.35
