# Component 2 configuration template. Copy to .env and fill in real values.
# .env is git-ignored; never commit credentials. This file holds placeholders only.

# Neo4j AuraDB (use the encrypted neo4j+s:// scheme for any non-local server)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<username>
NEO4J_PASSWORD=<password>

# Optional driver timeouts in seconds (defaults shown)
# C2_NEO4J_CONNECTION_TIMEOUT=10
# C2_NEO4J_ACQUISITION_TIMEOUT=15
# C2_NEO4J_MAX_RETRY_TIME=10
# C2_NEO4J_QUERY_TIMEOUT=15

# Evidence index used by the API (see docs/component2_implementation.md §4)
# C2_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# C2_EMBEDDING_DEVICE=cpu
# C2_RETRIEVAL_MIN_SIMILARITY=0.30

# Source-chunk store used for curation (see docs/knowledge_ingestion.md)
# C2_SOURCE_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Readiness report inputs (local files; counts only are exposed)
# C2_CORPUS_MANIFEST=corpus/extracted/manifest.json
# C2_CANDIDATE_STORE=corpus/extracted/candidates

# Optional LLM provider for research baselines and explanation rephrasing
# (python -m app.llm.baselines; see docs/component2_work_summary.md §2.6).
# Not used by the reasoning pipeline or the API. Put the real key only in .env.
# C2_LLM_PROVIDER=anthropic            # anthropic (default) or openai
# C2_LLM_MODEL=claude-opus-5-5         # required for openai
# C2_LLM_API_KEY=<your-api-key>        # or ANTHROPIC_API_KEY / OPENAI_API_KEY
# C2_LLM_BASE_URL=                     # optional third-party gateway endpoint
# C2_LLM_MAX_TOKENS=4096
# C2_LLM_TIMEOUT=120
# C2_LLM_MAX_RETRIES=2
# C2_LLM_EFFORT=                       # Claude only: low|medium|high|xhigh|max
# C2_LLM_REFUSAL_FALLBACK=on           # Claude only: server-side refusal fallback
