# AyurAI client configuration
# Copy to .env.local and adjust. Do not put secrets in VITE_* variables:
# every VITE_* value is embedded in the browser bundle.

# Base URLs used by the browser. The defaults go through the Vite dev proxy.
VITE_C2_API_BASE_URL=/c2-api
VITE_C3_API_BASE_URL=/c3-api
VITE_C4_API_BASE_URL=/c4-api

# Dev-server proxy targets (read by vite.config.ts, not exposed to the browser)
C2_PROXY_TARGET=http://127.0.0.1:8000
C3_PROXY_TARGET=http://127.0.0.1:8003
C4_PROXY_TARGET=http://127.0.0.1:8004

# Initial data mode: "demo" (fictional fixtures, nothing is sent) or "live"
VITE_DEFAULT_DATA_MODE=demo

# Request timeouts in milliseconds. Component 2 reasoning may load an
# embedding model on its first request, so it gets a longer timeout.
VITE_API_TIMEOUT_MS=20000
VITE_C2_REASONING_TIMEOUT_MS=180000
