# Settings for docker-compose.prod.yml. On the VPS:
#   cp .env.prod.example .env.prod   (then edit; .env.prod is git-ignored)
# Each component still reads its own component2/.env, component3/.env, component4/.env.

# Your domain (e.g. ayurai.example.com). Leave as "_" to use the bare IP over HTTP.
DOMAIN=_

# http until a certificate exists, then https (see deploy/README.md)
NGINX_CONF=http

# Component 1 data folder on the VPS (model weights + session records).
# Relative paths are relative to the repository folder; the default is a
# "datasets" folder next to it, e.g. ~/datasets for a repo in ~/ayurai.
C1_DATASETS_DIR=../datasets

# Component 1 patient name/phone registration and PDF reports.
# component4 = only signed-in practitioners/supervisors (default); off = disabled.
C1_PATIENT_DATA_ACCESS=component4

# PostgreSQL for the Component 4 API. Use letters and digits only in the
# password: it is placed inside a URL, so characters like @ : / # break it.
# Generate one with:  openssl rand -hex 24
POSTGRES_USER=ayurai
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ayurai_audit
